{
  "name": "jcore-siirto",
  "version": "0.1.0",
  "description": "Migrate a WordPress site to another installation: themes, plugins, media, files and database, using only administrator accounts.",
  "author": "J&Co Digital Oy <support@jco.fi>",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "format": "wp-scripts format src",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style 'src/**/*.scss' --allow-empty-input",
    "lint:php": "composer lint",
    "check": "pnpm lint:js && pnpm lint:css && pnpm lint:php",
    "i18n": "pnpm make-pot && pnpm make-mo && pnpm make-json",
    "make-pot": "wp i18n make-pot . languages/jcore-siirto.pot --domain=jcore-siirto --slug=jcore-siirto --exclude=vendor,node_modules,src,release,.wp",
    "make-mo": "wp i18n make-mo languages languages",
    "make-json": "pnpm --package=@wp-blocks/make-pot@1.6.3 dlx makejson build/ languages/",
    "playground": "wp-playground-cli server --blueprint=.wp/blueprint.json --mount=.:/wordpress/wp-content/plugins/jcore-siirto --php=8.2 --port=8829"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.27.0",
    "@wp-playground/cli": "^3.1.54",
    "typescript": "~6.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JCO-Digital/jcore-siirto.git"
  },
  "bugs": {
    "url": "https://github.com/JCO-Digital/jcore-siirto/issues"
  },
  "homepage": "https://github.com/JCO-Digital/jcore-siirto#readme"
}
